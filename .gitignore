# PlatformIO
.pio/
/include/M360Credentials.h


# Python
__pycache__/
*.pyc
.venv/
env/

# Node
node_modules/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Extensions
.history/

# Gerados pelo PlatformIO conforme o env ativo na IDE. Carregam caminhos
# absolutos da máquina local (inclusive o diretório de build em %TEMP%) e são
# reescritos a cada troca de env — versioná-los só produz conflito recorrente.
# Os demais arquivos de .vscode/ (extensions, settings, tasks) continuam versionados.
.vscode/c_cpp_properties.json
.vscode/launch.json

.bmad-loop/runs/
.bmad-loop/cache/

# KiCad — arquivos locais, regenerados pelo próprio KiCad. O .kicad_prl guarda o
# estado da interface (zoom, camadas visíveis, janela); os backups, os locks e o
# cache de footprints são por máquina. Versioná-los só produz diff sem conteúdo.
*.kicad_prl
*-backups/
*.lck
fp-info-cache

